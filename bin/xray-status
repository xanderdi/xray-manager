#!/bin/bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -r "${PROJECT_DIR}/lib/config.sh" ]]; then
    LIB_DIR="${PROJECT_DIR}/lib"
else
    LIB_DIR="/usr/local/lib/xray-manager"
fi

source "${LIB_DIR}/config.sh"

get_mode() {
    if [[ -r "$XRAY_MODE_FILE" ]]; then
        cat "$XRAY_MODE_FILE"
    else
        echo "UNKNOWN"
    fi
}

echo "=== Xray Manager ==="
echo "Mode: $(get_mode)"

if systemctl is-active --quiet "$XRAY_SERVICE"; then
    echo "Service: active"
else
    echo "Service: inactive"
fi

echo
echo "=== SOCKS ==="
ss -lnt 2>/dev/null | grep ":${XRAY_SOCKS_PORT}" \
    || echo "${XRAY_SOCKS_HOST}:${XRAY_SOCKS_PORT} not listening"

echo
echo "=== TUN ==="
if ip link show "$XRAY_IF" >/dev/null 2>&1; then
    ip -4 addr show "$XRAY_IF"
else
    echo "$XRAY_IF absent"
fi

echo
echo "=== Routes ==="
ip -4 route show
