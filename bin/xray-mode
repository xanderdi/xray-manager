#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -r "${PROJECT_DIR}/lib/config.sh" ]]; then
    LIB_DIR="${PROJECT_DIR}/lib"
else
    LIB_DIR="/usr/local/lib/xray-manager"
fi

source "${LIB_DIR}/config.sh"
source "${LIB_DIR}/routes.sh"

usage() {
    echo "Usage: xray-mode {off|socks|split|full|restore}"
    exit 1
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "ERROR: run with sudo"
        exit 1
    fi
}

set_mode() {
    mkdir -p "$XRAY_STATE_DIR"
    printf '%s\n' "$1" > "$XRAY_MODE_FILE"
}

get_mode() {
    if [[ -r "$XRAY_MODE_FILE" ]]; then
        cat "$XRAY_MODE_FILE"
    else
        echo "UNKNOWN"
    fi
}

mode_off() {
    full_routes_del
    dns_bypass_del
    server_bypass_del
    systemctl stop "$XRAY_SERVICE"
    tun_cleanup
    set_mode "OFF"
    echo "Mode: OFF"
}

mode_socks() {
    full_routes_del
    dns_bypass_del
    server_bypass_del

    cp -f "$XRAY_SOCKS_CONFIG" "$XRAY_ACTIVE_CONFIG"

    validate_tun_config "$XRAY_ACTIVE_CONFIG"

    systemctl restart "$XRAY_SERVICE"
    tun_cleanup

    # Wait until SOCKS listener is actually ready
    for _ in {1..20}; do
        if ss -lnt 2>/dev/null | grep -q ":${XRAY_SOCKS_PORT}"; then
            break
        fi
        sleep 0.1
    done

    if ! ss -lnt 2>/dev/null | grep -q ":${XRAY_SOCKS_PORT}"; then
        echo "ERROR: Xray started, but SOCKS port ${XRAY_SOCKS_HOST}:${XRAY_SOCKS_PORT} is not listening"
        exit 1
    fi

    set_mode "SOCKS"

    echo "Mode: SOCKS"
    echo "SOCKS5: ${XRAY_SOCKS_HOST}:${XRAY_SOCKS_PORT}"
}

validate_tun_config() {
    local config="$1"
    local tmp

    tmp="$(mktemp --suffix=.json)"

    python3 - "$config" "$tmp" "$$" <<'PYCFG'
import json
import sys

src, dst, pid = sys.argv[1:4]

with open(src) as f:
    cfg = json.load(f)

for inbound in cfg.get("inbounds", []):
    if inbound.get("tag") == "tun-in":
        inbound.setdefault("settings", {})["name"] = f"xrt{pid}"

with open(dst, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PYCFG

    "$XRAY_BIN" run -test -config "$tmp" >/dev/null
    rm -f "$tmp"
}

mode_split() {
    cp -f "$XRAY_SPLIT_CONFIG" "$XRAY_ACTIVE_CONFIG"

    validate_tun_config "$XRAY_ACTIVE_CONFIG"
    systemctl restart "$XRAY_SERVICE"

    for _ in {1..20}; do
        [[ -e /sys/class/net/xray0 ]] && break
        sleep 0.1
    done

    [[ -e /sys/class/net/xray0 ]] || {
        echo "ERROR: xray0 was not created"
        return 1
    }

    tun_prepare
    server_bypass_add
    dns_bypass_add
    full_routes_add

    set_mode "SPLIT"

    echo "Mode: SPLIT"
}

mode_full() {
    cp -f "$XRAY_FULL_CONFIG" "$XRAY_ACTIVE_CONFIG"

    validate_tun_config "$XRAY_ACTIVE_CONFIG"
    systemctl restart "$XRAY_SERVICE"

    for _ in {1..20}; do
        [[ -e /sys/class/net/xray0 ]] && break
        sleep 0.1
    done

    [[ -e /sys/class/net/xray0 ]] || {
        echo "ERROR: xray0 was not created"
        return 1
    }

    tun_prepare
    server_bypass_add
    full_routes_add

    set_mode "FULL"

    echo "Mode: FULL"
}

mode_restore() {
    local saved_mode="SOCKS"

    if [[ -r "$XRAY_MODE_FILE" ]]; then
        saved_mode="$(cat "$XRAY_MODE_FILE")"
    fi

    case "$saved_mode" in
        OFF) mode_off ;;
        SOCKS) mode_socks ;;
        SPLIT) mode_split ;;
        FULL) mode_full ;;
        *)
            echo "WARNING: invalid saved mode: $saved_mode"
            echo "Falling back to SOCKS"
            mode_socks
            ;;
    esac
}

case "${1:-}" in
    off)
        require_root
        mode_off
        ;;
    socks)
        require_root
        mode_socks
        ;;
    split)
        require_root
        mode_split
        ;;
    full)
        require_root
        mode_full
        ;;
    restore)
        require_root
        mode_restore
        ;;
    *)
        usage
        ;;
esac
